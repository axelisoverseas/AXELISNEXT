# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code tooling / skills (local dev only)
/.claude/
/.agents/
skills-lock.json

# dev logs
dev3000.log

# Brand review bundle — deploys from its own repo, and carries document
# templates that get filled with bank details before issue. Never commit here.
/brand-review/

# Wikidata SPARQL responses cached by scripts/fetch-universities.mjs
/scripts/.cache/

# Playwright artifacts. Also excluded from Tailwind scanning in globals.css:
# an RSC payload in a saved snapshot generated an unparseable utility class.
test-results/
playwright-report/

.DS_Store

# Real student PII from incentive sheets — never commit (no per-student consent)
docs/students/

# Word/Office lock files, created while a doc is open
.~*
**/.~*
